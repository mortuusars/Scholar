{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.scholar.fabric.ScholarFabric"
    ],
    "client": [
      "io.github.mortuusars.scholar.fabric.ScholarFabricClient"
    ],
    "jei_mod_plugin": [
      "io.github.mortuusars.scholar.integration.jei.ScholarJeiPlugin"
    ]
  },
  "mixins": [
    "scholar-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${fabric_supported_minecraft_versions}",
    "fabric-api": "*",
    "fabricloader": ">=0.16.0",
    "forgeconfigapiport": ">=${required_forge_config_api_port_version}"
  }
}